# Kopier til .env.local (lokal utvikling) / .env (produksjon) og fyll inn.

# SQLite-database (filbasert). Kan pekes til et persistent volum i produksjon.
DATABASE_URL="file:./dev.db"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials).
# VIKTIG: Sett OAuth-samtykkeskjermen til "Production" (ikke "Testing") FØR
# noen av de to brukerne logger inn. I "Testing" utløper refresh token etter
# 7 dager, og den automatiske kjøringen (mandag/daglig) stopper stille.
# Aktiver Google Calendar API for prosjektet.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Generer med: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Kassal.app (kassal.app/api) — gratis for ikke-kommersiell bruk. Valgfritt i
# fase 1 (brukes til prissammenligning; ikke tilbud). Opprett nøkkel på
# kassal.app.
KASSALAPP_API_KEY=""

# Hemmelig token som scripts/scheduler.ts sender med når den kaller de interne
# cron-endepunktene, slik at de ikke kan trigges av hvem som helst.
CRON_SECRET=""

# Base-URL appen kjører på (brukes av scheduler-scriptet til å kalle API-et).
APP_URL="http://localhost:3000"
